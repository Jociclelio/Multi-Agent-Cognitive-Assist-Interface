{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "description": "``SourceRef`` — origem física resolvível no snapshot (mapa §4/§6.7).\nA resolvibilidade no snapshot é verificada em leitura (task de\narmazenamento); o contrato fixa a forma.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "doc_id": {
          "format": "uuid",
          "title": "Doc Id",
          "type": "string"
        },
        "offsets": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offsets"
        },
        "physical_page": {
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "version_id",
        "physical_page",
        "block_id",
        "text_hash"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``RubricCriterion`` — critério de rubrica por tópico (mapa §15.2):\nid, ``topic_ids`` não vazio, níveis 0/1/2 (0=incorreto/ausente, 1=parcial,\n2=adequado — inerente ao contrato, não campo), ``critical``,\n``accepted_equivalences`` e ``evidence_refs``. Critério de múltiplos\ntópicos deve ser decomposto pelo autor da rubrica quando não permitir\natribuição separada (§15.2); o redutor não atualiza o estado dos tópicos\ncobertos por critério multicomponente não decomposto.",
  "properties": {
    "accepted_equivalences": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Accepted Equivalences",
      "type": "array"
    },
    "criterion_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Criterion Id",
      "type": "string"
    },
    "critical": {
      "default": false,
      "title": "Critical",
      "type": "boolean"
    },
    "description": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    },
    "topic_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Topic Ids",
      "type": "array"
    }
  },
  "required": [
    "criterion_id",
    "topic_ids",
    "description"
  ],
  "title": "RubricCriterion",
  "type": "object"
}
