{
  "additionalProperties": false,
  "description": "``SourceRef`` — origem física resolvível no snapshot (mapa §4/§6.7).\nA resolvibilidade no snapshot é verificada em leitura (task de\narmazenamento); o contrato fixa a forma.",
  "properties": {
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "block_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Block Id",
      "type": "string"
    },
    "doc_id": {
      "format": "uuid",
      "title": "Doc Id",
      "type": "string"
    },
    "offsets": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offsets"
    },
    "physical_page": {
      "minimum": 1,
      "title": "Physical Page",
      "type": "integer"
    },
    "text_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Hash",
      "type": "string"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "doc_id",
    "version_id",
    "physical_page",
    "block_id",
    "text_hash"
  ],
  "title": "SourceRef",
  "type": "object"
}
