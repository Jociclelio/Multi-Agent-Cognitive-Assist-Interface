# Configuração de Ambiente — EduAgent-OS v0.1 e Notebooks da Disciplina
# Copie este arquivo para .env e ajuste conforme seu ambiente local:
#   cp .env.example .env
# NUNCA versione chaves de API reais ou arquivos .env no repositório.

# ---------------------------------------------------------------------------
# 1. EduAgent-OS v0.1 (Núcleo Multiagente Local — 100% Offline)
# ---------------------------------------------------------------------------
# Fuso horário IANA do estudante (quando omitido, o sistema detecta
# automaticamente o fuso do sistema operacional/navegador e possui fallback
# interativo para confirmação):
EDUAGENT_TIMEZONE=America/Sao_Paulo

# Diretório local de persistência SQLite WAL e artefatos (default: data):
EDUAGENT_DATA_ROOT=data

# Porta HTTP da API Loopback e Interface Gráfica Local (default: 8094):
EDUAGENT_API_PORT=8094

# Runtime de Inferência Local (fork PrismML-Eng/llama.cpp em loopback):
LLAMA_CPP_BASE_URL=http://127.0.0.1:8079/v1
LLAMA_CPP_MODEL=bonsai2-ptq1-0
OPENAI_BASE_URL=http://127.0.0.1:8079/v1
OPENAI_API_KEY=not-needed

# Diretório local do embedder denso BAAI/bge-m3:
EDUAGENT_EMBEDDER_DIR=runner-llm/models/bge-m3

# ---------------------------------------------------------------------------
# 2. Variáveis Opcionais para os Notebooks Pedagógicos da Disciplina (docs/)
# ---------------------------------------------------------------------------
OLLAMA_API_KEY=seu_token_aqui
LANGSMITH_API_KEY=seu_token_aqui
